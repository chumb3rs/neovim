snippet mtd "Markdown metadata front matter" bA
\-\-\-
title: "$1"
date: `!p from datetime import datetime
if not snip.c:
    snip.rv=datetime.now().strftime("%Y-%m-%d %H:%M:%S%z")`
tags: [$2]
categories: [$3]
\-\-\-
endsnippet

snippet h1 "Add Heading 1" bA
# ${1:${VISUAL:}}$0
endsnippet

snippet h2 "Add Heading 2" bA
## ${1:${VISUAL:}}$0
endsnippet

snippet h3 "Add Heading 3" bA
### ${1:${VISUAL:}}$0
endsnippet

snippet h4 "Add Heading 4" bA
#### ${1:${VISUAL:}}$0
endsnippet

snippet tbb "Insert bold text" A
**${1:${VISUAL}}**$0
endsnippet

snippet tii "Insert italic text" A
*${1:${VISUAL}}*$0
endsnippet

snippet tbi "Insert bold-italic text" A
***${1:${VISUAL}}***$0
endsnippet

snippet thh "Insert highlighted text" A
==${1:${VISUAL}}==$0
endsnippet

snippet hf "Insert hyperlink" A
[${1:${VISUAL}alias}]($2)$0
endsnippet

snippet img "Insert image" bA
![${1:alt}]($2)$0
endsnippet

priority 2
snippet cbb "Insert code block" bA
\`\`\`$1
${2:${VISUAL}}
\`\`\`
$0
endsnippet

priority 1
snippet cbb "Insert inline-code" A
\`${1:${VISUAL}}\`
endsnippet

snippet cxo "Insert an uncompleted checkbox" bA
- [  ] $0
endsnippet

snippet cxx "Insert a completed checkbox" bA
- [x] $0
endsnippet
